# Optional, server-only configuration. Never use VITE_ for provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
HOST=127.0.0.1
PORT=4173

# Arena runs with the existing Node server. Set exact browser origins when deploying.
# ARENA_ALLOWED_ORIGINS=https://your-game.example
# ARENA_PUBLIC_URL=https://your-game.example
# Optional separate backend (build-time client setting); omit for same-origin hosting.
# VITE_ARENA_SERVER_URL=https://your-arena-backend.example
